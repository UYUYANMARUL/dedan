# Copy to deploy/devnet/world-id.env (keep it private: the signing key authenticates Dedan's World ID requests).
# From https://developer.world.org: create an app with World ID 4.0; staging works with the World ID Simulator
# (https://simulator.worldcoin.org), production with World App. See WORLD-ID.md.
DEDAN_WORLD_ID_APP_ID=app_...
DEDAN_WORLD_ID_RP_ID=rp_...
DEDAN_WORLD_ID_SIGNING_KEY=0x...
DEDAN_WORLD_ID_ENV=staging
